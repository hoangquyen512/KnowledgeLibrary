APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
API_PUBLIC_URL=http://localhost:8000

DATABASE_URL=postgresql+asyncpg://knowledge:knowledge@postgres:5432/knowledge
DATABASE_URL_SYNC=postgresql://knowledge:knowledge@postgres:5432/knowledge
REDIS_URL=redis://redis:6379/0

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=knowledge-library
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Generate a 32-byte url-safe key for local dev, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Generate a long random string
SESSION_SECRET=

CONNECTOR_SIGNING_SECRET=

EMBEDDING_MODEL=bge-m3
EMBEDDING_SERVICE_URL=http://embedding-service:8080
EMBEDDING_DIMENSION=1024

# Cookie / CSRF
SESSION_COOKIE_NAME=kl_session
CSRF_COOKIE_NAME=kl_csrf
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=604800

# Dev seed (optional)
DEMO_MODE=false
SEED_SUPER_ADMIN_EMAIL=

# Ask AI (Gemini). gemini-2.0-flash is deprecated for new API keys — use 2.5+.
GEMINI_MODEL=gemini-3.7-flash
