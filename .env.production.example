# Copy to .env.production and fill secrets before:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Generate secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=production
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
API_PUBLIC_URL=http://localhost:8000

# --- Postgres (compose service) ---
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=knowledge
DATABASE_URL=postgresql+asyncpg://knowledge:CHANGE_ME_strong_db_password@postgres:5432/knowledge
DATABASE_URL_SYNC=postgresql://knowledge:CHANGE_ME_strong_db_password@postgres:5432/knowledge

REDIS_URL=redis://redis:6379/0

# --- MinIO / S3 ---
MINIO_ROOT_USER=knowledge_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=knowledge-library
S3_ACCESS_KEY=knowledge_minio
S3_SECRET_KEY=CHANGE_ME_strong_minio_password
S3_REGION=us-east-1

# --- App secrets (required) ---
APP_ENCRYPTION_KEY=
SESSION_SECRET=
CONNECTOR_SIGNING_SECRET=

# --- Google OAuth (add this redirect URI in Google Cloud Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Optional: first super-admin after login (email must match Google account)
SEED_SUPER_ADMIN_EMAIL=

EMBEDDING_MODEL=bge-m3
EMBEDDING_SERVICE_URL=http://embedding-service:8080
EMBEDDING_DIMENSION=1024

# HTTP-only until you terminate TLS (set true behind HTTPS later)
SESSION_COOKIE_NAME=kl_session
CSRF_COOKIE_NAME=kl_csrf
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=604800

DEMO_MODE=false
GEMINI_MODEL=gemini-3.7-flash

# Web (server-side rewrite to API inside Docker network)
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://api:8000
